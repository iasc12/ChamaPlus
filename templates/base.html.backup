<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}ChamaPlus{% endblock %}</title>

    <style>
        :root {
            --primary: #166534;
            --primary-dark: #14532d;
            --primary-light: #dcfce7;

            --accent: #22c55e;

            --dark: #0f172a;
            --dark-soft: #1e293b;

            --text: #172033;
            --muted: #64748b;

            --background: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;

            --success: #15803d;
            --warning: #b45309;
            --danger: #dc2626;
            --info: #0369a1;

            --radius-sm: 10px;
            --radius-md: 16px;
            --radius-lg: 22px;

            --shadow-sm: 0 2px 10px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 10px 30px rgba(15, 23, 42, 0.07);
            --shadow-lg: 0 18px 45px rgba(15, 23, 42, 0.10);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at top left,
                    rgba(34, 197, 94, 0.07),
                    transparent 28%
                ),
                var(--background);

            color: var(--text);
            padding-bottom: 96px;
            line-height: 1.55;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        /* =========================
           TOP BAR
        ========================= */

        .topbar {
            position: sticky;
            top: 0;
            z-index: 900;

            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            color: white;

            border-bottom: 1px solid rgba(255, 255, 255, 0.07);

            box-shadow:
                0 5px 25px rgba(15, 23, 42, 0.12);
        }

        .topbar-inner {
            width: min(1180px, 94%);
            min-height: 70px;
            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            font-size: 21px;
            font-weight: 850;
            letter-spacing: -0.6px;
        }

        .brand-mark {
            width: 36px;
            height: 36px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    #16a34a
                );

            color: white;

            font-size: 17px;
            font-weight: 900;

            box-shadow:
                0 6px 18px rgba(34, 197, 94, 0.28);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-pill {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 7px 11px;

            border-radius: 999px;

            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.08);

            color: #e2e8f0;

            font-size: 12px;
            font-weight: 700;
        }

        .user-avatar {
            width: 28px;
            height: 28px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #22c55e;
            color: white;

            font-size: 11px;
            font-weight: 800;
        }

        /* =========================
           MAIN CONTAINER
        ========================= */

        .container {
            width: min(1180px, 94%);
            margin: 32px auto;
        }

        /* =========================
           CARDS
        ========================= */

        .card {
            background: var(--surface);
            border: 1px solid rgba(226, 232, 240, 0.9);

            border-radius: var(--radius-lg);

            padding: 28px;

            box-shadow: var(--shadow-md);
        }

        .card:hover {
            box-shadow: var(--shadow-lg);
        }

        /* =========================
           BUTTONS
        ========================= */

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            border: none;
            border-radius: 12px;

            padding: 11px 17px;

            font-size: 14px;
            font-weight: 750;

            cursor: pointer;

            transition:
                transform 0.18s ease,
                box-shadow 0.18s ease,
                background 0.18s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: var(--primary);
            color: white;

            box-shadow:
                0 7px 18px rgba(22, 101, 52, 0.18);
        }

        .btn-primary:hover {
            background: var(--primary-dark);

            box-shadow:
                0 10px 24px rgba(22, 101, 52, 0.24);
        }

        .btn-light {
            background: #f1f5f9;
            color: var(--text);
        }

        .btn-light:hover {
            background: #e2e8f0;
        }

        .btn-danger {
            background: #fee2e2;
            color: var(--danger);
        }

        .btn-success {
            background: var(--primary-light);
            color: var(--success);
        }

        /* =========================
           FORMS
        ========================= */

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 7px;

            color: #334155;

            font-size: 13px;
            font-weight: 750;
        }

        input,
        textarea,
        select {
            width: 100%;

            padding: 12px 14px;

            border: 1px solid #d7dee8;
            border-radius: 12px;

            background: white;
            color: var(--text);

            font-size: 14px;

            outline: none;

            transition:
                border-color 0.18s ease,
                box-shadow 0.18s ease;
        }

        input::placeholder,
        textarea::placeholder {
            color: #94a3b8;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: var(--primary);

            box-shadow:
                0 0 0 4px rgba(34, 197, 94, 0.10);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* =========================
           MESSAGES
        ========================= */

        .messages {
            margin-bottom: 22px;
        }

        .message {
            position: relative;

            padding: 13px 16px;
            margin-bottom: 9px;

            border-radius: 13px;

            background: #eff6ff;
            border: 1px solid #dbeafe;

            color: #1e40af;

            font-size: 13px;
            font-weight: 600;

            box-shadow: var(--shadow-sm);
        }

        .message.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .message.error {
            background: #fef2f2;
            border-color: #fecaca;
            color: #991b1b;
        }

        .message.warning {
            background: #fffbeb;
            border-color: #fde68a;
            color: #92400e;
        }

        /* =========================
           BADGES
        ========================= */

        .badge {
            display: inline-flex;
            align-items: center;

            padding: 5px 9px;

            border-radius: 999px;

            font-size: 11px;
            font-weight: 800;

            line-height: 1;
        }

        .badge-success {
            background: #dcfce7;
            color: #166534;
        }

        .badge-warning {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-danger {
            background: #fee2e2;
            color: #991b1b;
        }

        .badge-info {
            background: #e0f2fe;
            color: #075985;
        }

        .badge-neutral {
            background: #f1f5f9;
            color: #475569;
        }

        /* =========================
           BOTTOM NAVIGATION
        ========================= */

        .bottom-nav {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;

            z-index: 1000;

            height: 78px;

            background: rgba(255, 255, 255, 0.96);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);

            border-top: 1px solid rgba(226, 232, 240, 0.95);

            box-shadow:
                0 -10px 35px rgba(15, 23, 42, 0.08);
        }

        .bottom-nav-inner {
            width: min(720px, 100%);
            height: 100%;

            margin: 0 auto;

            display: grid;
            grid-template-columns: repeat(4, 1fr);

            align-items: center;
        }

        .nav-item {
            position: relative;

            height: 100%;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            gap: 4px;

            color: #94a3b8;

            font-size: 10px;
            font-weight: 800;

            transition:
                color 0.2s ease,
                transform 0.2s ease;
        }

        .nav-item:hover {
            color: var(--primary);
            transform: translateY(-1px);
        }

        .nav-icon {
            width: 22px;
            height: 22px;

            stroke: currentColor;
            fill: none;

            stroke-width: 1.9;

            stroke-linecap: round;
            stroke-linejoin: round;

            transition:
                transform 0.2s ease,
                stroke-width 0.2s ease;
        }

        .nav-item.active {
            color: var(--primary);
        }

        .nav-item.active .nav-icon {
            stroke-width: 2.4;
            transform: translateY(-1px);
        }

        .nav-item.active::after {
            content: "";

            position: absolute;

            bottom: 7px;

            width: 24px;
            height: 3px;

            border-radius: 999px;

            background: var(--accent);
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            width: min(1180px, 94%);
            margin: 0 auto;

            padding: 28px 0 12px;

            text-align: center;

            color: #94a3b8;

            font-size: 12px;
        }

        /* =========================
           UTILITY CLASSES
        ========================= */

        .text-muted {
            color: var(--muted);
        }

        .text-success {
            color: var(--success);
        }

        .text-danger {
            color: var(--danger);
        }

        .text-warning {
            color: var(--warning);
        }

        .text-center {
            text-align: center;
        }

        .flex {
            display: flex;
        }

        .items-center {
            align-items: center;
        }

        .justify-between {
            justify-content: space-between;
        }

        .gap-1 {
            gap: 8px;
        }

        .gap-2 {
            gap: 12px;
        }

        .gap-3 {
            gap: 18px;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            body {
                padding-bottom: 84px;
            }

            .topbar-inner {
                min-height: 64px;
                width: 94%;
            }

            .brand {
                font-size: 19px;
            }

            .brand-mark {
                width: 34px;
                height: 34px;
            }

            .user-pill {
                padding: 5px 7px;
            }

            .user-pill span {
                display: none;
            }

            .container {
                width: 94%;
                margin: 22px auto;
            }

            .card {
                padding: 20px;
                border-radius: 18px;
            }

            .bottom-nav {
                height: 74px;
            }

            .nav-item {
                font-size: 9px;
            }

            .nav-icon {
                width: 21px;
                height: 21px;
            }

            .nav-item.active::after {
                bottom: 5px;
            }

            .btn {
                padding: 11px 14px;
            }
        }

        @media (max-width: 420px) {

            .brand {
                font-size: 18px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
            }

            .bottom-nav-inner {
                grid-template-columns: repeat(4, 1fr);
            }

            .nav-item {
                font-size: 8.5px;
            }
        }
    </style>

    {% block extra_css %}{% endblock %}
</head>

<body>

<header class="topbar">

    <div class="topbar-inner">

        <a href="{% url 'dashboard' %}" class="brand">
            <span class="brand-mark">C+</span>
            <span>ChamaPlus</span>
        </a>

        {% if user.is_authenticated %}

            <div class="topbar-right">

                <div class="user-pill">

                    <span class="user-avatar">
                        {{ user.username|first|upper }}
                    </span>

                    <span>
                        {{ user.username }}
                    </span>

                </div>

            </div>

        {% endif %}

    </div>

</header>


<main class="container">

    {% if messages %}

        <div class="messages">

            {% for message in messages %}

                <div class="message {{ message.tags }}">
                    {{ message }}
                </div>

            {% endfor %}

        </div>

    {% endif %}


    {% block content %}{% endblock %}

</main>


{% if user.is_authenticated %}

<nav class="bottom-nav">

    <div class="bottom-nav-inner">

        {% if user.profile.role == "MEMBER" %}

            <!-- MEMBER HOME -->

            <a
                href="{% url 'dashboard' %}"
                class="nav-item {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M3 10.5 12 3l9 7.5"></path>
                    <path d="M5 9.5V21h14V9.5"></path>
                    <path d="M9 21v-6h6v6"></path>
                </svg>

                <span>Home</span>
            </a>


            <!-- MEMBER SAVINGS -->

            <a
                href="{% url 'savings' %}"
                class="nav-item {% if request.resolver_match.url_name == 'savings' or request.resolver_match.url_name == 'record_saving' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M12 3v18"></path>
                    <path d="M17 7.5c0-2-2.2-3.5-5-3.5S7 5.5 7 7.5 9 11 12 11s5 1.5 5 3.5-2.2 3.5-5 3.5-5-1.5-5-3.5"></path>
                </svg>

                <span>Savings</span>
            </a>


            <!-- MEMBER LOANS -->

            <a
                href="{% url 'loans' %}"
                class="nav-item {% if request.resolver_match.url_name == 'loans' or request.resolver_match.url_name == 'apply_for_loan' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <path d="M7 15h3"></path>
                </svg>

                <span>Loans</span>
            </a>


            <!-- MEMBER ACCOUNT -->

            <a
                href="{% url 'subscription' %}"
                class="nav-item {% if request.resolver_match.url_name == 'subscription' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"></path>
                </svg>

                <span>Account</span>
            </a>

        {% elif user.profile.role == "TREASURER" %}

            <!-- TREASURER HOME -->

            <a
                href="{% url 'dashboard' %}"
                class="nav-item {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M3 10.5 12 3l9 7.5"></path>
                    <path d="M5 9.5V21h14V9.5"></path>
                    <path d="M9 21v-6h6v6"></path>
                </svg>

                <span>Home</span>
            </a>


            <!-- TREASURER SAVINGS -->

            <a
                href="{% url 'savings' %}"
                class="nav-item {% if request.resolver_match.url_name == 'savings' or request.resolver_match.url_name == 'record_saving' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M12 3v18"></path>
                    <path d="M17 7.5c0-2-2.2-3.5-5-3.5S7 5.5 7 7.5 9 11 12 11s5 1.5 5 3.5-2.2 3.5-5 3.5-5-1.5-5-3.5"></path>
                </svg>

                <span>Savings</span>
            </a>


            <!-- TREASURER PERSONAL LOANS -->

            <a
                href="{% url 'loans' %}"
                class="nav-item {% if request.resolver_match.url_name == 'loans' or request.resolver_match.url_name == 'apply_for_loan' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <path d="M7 15h3"></path>
                </svg>

                <span>My Loans</span>
            </a>


            <!-- TREASURER AREA -->

            <a
                href="{% url 'treasurer_dashboard' %}"
                class="nav-item {% if request.resolver_match.url_name == 'treasurer_dashboard' or request.resolver_match.url_name == 'chama_members' or request.resolver_match.url_name == 'treasurer_loans' or request.resolver_match.url_name == 'review_loan' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M4 19V5"></path>
                    <path d="M4 19h16"></path>
                    <path d="M8 16v-5"></path>
                    <path d="M12 16V7"></path>
                    <path d="M16 16v-8"></path>
                </svg>

                <span>Treasurer</span>
            </a>

        {% elif user.profile.role == "ADMIN" or user.is_superuser %}

            <!-- ADMIN HOME -->

            <a
                href="{% url 'dashboard' %}"
                class="nav-item {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M3 10.5 12 3l9 7.5"></path>
                    <path d="M5 9.5V21h14V9.5"></path>
                    <path d="M9 21v-6h6v6"></path>
                </svg>

                <span>Home</span>
            </a>


            <!-- ADMIN SAVINGS -->

            <a
                href="{% url 'savings' %}"
                class="nav-item {% if request.resolver_match.url_name == 'savings' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M12 3v18"></path>
                    <path d="M17 7.5c0-2-2.2-3.5-5-3.5S7 5.5 7 7.5 9 11 12 11s5 1.5 5 3.5-2.2 3.5-5 3.5-5-1.5-5-3.5"></path>
                </svg>

                <span>Savings</span>
            </a>


            <!-- ADMIN CHAMA -->

            <a
                href="{% url 'chama_management' %}"
                class="nav-item {% if request.resolver_match.url_name == 'chama_management' or request.resolver_match.url_name == 'create_treasurer' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>

                <span>Chama</span>
            </a>


            <!-- ADMIN ACCOUNT -->

            <a
                href="{% url 'subscription' %}"
                class="nav-item {% if request.resolver_match.url_name == 'subscription' %}active{% endif %}"
            >
                <svg class="nav-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"></path>
                </svg>

                <span>Account</span>
            </a>

        {% endif %}

    </div>

</nav>

{% endif %}


<footer>
    ChamaPlus &copy; {% now "Y" %}
</footer>

</body>
</html>
