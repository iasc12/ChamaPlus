{
    "name": "ChamaPlus",
    "short_name": "ChamaPlus",
    "description": "Savings, loans and Chama management made simple.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone"
    ],
    "orientation": "portrait-primary",
    "background_color": "#ffffff",
    "theme_color": "#0b5ed7",
    "categories": [
        "finance",
        "business",
        "productivity"
    ],
    "icons": [
        {
            "src": "/static/pwa/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/pwa/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+chamaplus",
            "url": "/?protocol=%s"
        }
    ]
}
